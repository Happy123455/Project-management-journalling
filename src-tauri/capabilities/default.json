{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/attachments/**"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/Dynamic Journal Backups"
        },
        {
          "path": "$DOCUMENT/Dynamic Journal Backups/**"
        },
        {
          "path": "$HOME/Library/CloudStorage"
        },
        {
          "path": "$HOME/Library/CloudStorage/*"
        },
        {
          "path": "$HOME/Library/CloudStorage/*/My Drive/Dynamic Journal Sync"
        },
        {
          "path": "$HOME/Library/CloudStorage/*/My Drive/Dynamic Journal Sync/**"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-read-file",
    { "identifier": "http:default", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}